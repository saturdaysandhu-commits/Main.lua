
-- AJJANS FINDER
-- Standalone pet finder interface
-- Sample data only; no access to private game data.

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local pets = {
    {name="Golden Dragon", rarity="Divine", value=1000000000, category="Egg"},
    {name="Rainbow Phoenix", rarity="Eternal", value=850000000, category="Egg"},
    {name="Shadow Cat", rarity="Legendary", value=500000000, category="Paw"},
    {name="Frost Wolf", rarity="Mythical", value=650000000, category="Halloween"},
}

local old = playerGui:FindFirstChild("AJJANS FINDER")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "AJJANS FINDER"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Name = "Main"
frame.Size = UDim2.new(0.88, 0, 0.68, 0)
frame.Position = UDim2.new(0.06, 0, 0.16, 0)
frame.BackgroundColor3 = Color3.fromRGB(20,20,29)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,14)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(120,75,220)
stroke.Thickness = 2
stroke.Parent = frame

local function label(parent, text, size, position, color)
    local obj = Instance.new("TextLabel")
    obj.BackgroundTransparency = 1
    obj.Text = text
    obj.Size = size
    obj.Position = position
    obj.TextColor3 = color or Color3.new(1,1,1)
    obj.Font = Enum.Font.GothamBold
    obj.TextScaled = true
    obj.Parent = parent
    return obj
end

local title = label(
    frame,
    "AJJANS FINDER 🥚",
    UDim2.new(0.8,0,0,42),
    UDim2.new(0.05,0,0,5),
    Color3.fromRGB(210,170,255)
)

local close = Instance.new("TextButton")
close.Size = UDim2.new(0,35,0,35)
close.Position = UDim2.new(1,-42,0,7)
close.Text = "X"
close.TextScaled = true
close.Font = Enum.Font.GothamBold
close.TextColor3 = Color3.new(1,1,1)
close.BackgroundColor3 = Color3.fromRGB(180,45,65)
close.Parent = frame
Instance.new("UICorner",close).CornerRadius = UDim.new(0,8)

close.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

local search = Instance.new("TextBox")
search.Size = UDim2.new(0.94,0,0,38)
search.Position = UDim2.new(0.03,0,0,53)
search.PlaceholderText = "Search pets..."
search.Text = ""
search.TextSize = 16
search.Font = Enum.Font.Gotham
search.TextColor3 = Color3.new(1,1,1)
search.PlaceholderColor3 = Color3.fromRGB(160,160,170)
search.BackgroundColor3 = Color3.fromRGB(38,38,51)
search.ClearTextOnFocus = false
search.Parent = frame
Instance.new("UICorner",search).CornerRadius = UDim.new(0,8)

local categories = {"All","Egg","Paw","Halloween"}
local selected = "All"
local buttons = {}

local function makeButton(text, index)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.23,0,0,32)
    b.Position = UDim2.new(0.025+(index-1)*0.245,0,0,101)
    b.Text = text
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = Color3.new(1,1,1)
    b.BackgroundColor3 = Color3.fromRGB(48,43,65)
    b.Parent = frame
    Instance.new("UICorner",b).CornerRadius = UDim.new(0,7)
    buttons[text] = b
    return b
end

for i, category in ipairs(categories) do
    local button = makeButton(category,i)
    button.MouseButton1Click:Connect(function()
        selected = category
        update()
    end)
end

local count = label(
    frame,
    "PET RESULTS",
    UDim2.new(0.94,0,0,25),
    UDim2.new(0.03,0,0,143),
    Color3.fromRGB(190,170,255)
)
count.TextXAlignment = Enum.TextXAlignment.Left

local scroll = Instance.new("ScrollingFrame")
scroll.Name = "PetResults"
scroll.Size = UDim2.new(0.94,0,0.68,0)
scroll.Position = UDim2.new(0.03,0,0,172)
scroll.BackgroundColor3 = Color3.fromRGB(27,27,38)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 5
scroll.CanvasSize = UDim2.new(0,0,0,0)
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.Parent = frame

Instance.new("UICorner",scroll).CornerRadius = UDim.new(0,8)

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0,8)
padding.PaddingLeft = UDim.new(0,8)
padding.PaddingRight = UDim.new(0,8)
padding.Parent = scroll

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0,8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = scroll

local function formatValue(value)
    return string.format("%.0f",value)
end

function update()
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    for name, button in pairs(buttons) do
        button.BackgroundColor3 =
            name == selected
            and Color3.fromRGB(115,65,190)
            or Color3.fromRGB(48,43,65)
    end

    local searchText = search.Text:lower()
    local found = 0

    for _, pet in ipairs(pets) do
        local matchesName =
            pet.name:lower():find(searchText,1,true) ~= nil

        local matchesCategory =
            selected == "All" or pet.category == selected

        if matchesName and matchesCategory then
            found += 1

            local card = Instance.new("Frame")
            card.Size = UDim2.new(1,-5,0,76)
            card.BackgroundColor3 = Color3.fromRGB(42,39,55)
            card.BorderSizePixel = 0
            card.LayoutOrder = found
            card.Parent = scroll

            Instance.new("UICorner",card).CornerRadius =
                UDim.new(0,9)

            label(
                card,
                pet.name,
                UDim2.new(0.95,0,0,25),
                UDim2.new(0.025,0,0,5),
                Color3.fromRGB(255,220,130)
            )

            label(
                card,
                "Rarity: "..pet.rarity..
                "  |  Category: "..pet.category,
                UDim2.new(0.95,0,0,19),
                UDim2.new(0.025,0,0,32),
                Color3.fromRGB(205,205,220)
            )

            label(
                card,
                "Value: "..formatValue(pet.value),
                UDim2.new(0.95,0,0,18),
                UDim2.new(0.025,0,0,53),
                Color3.fromRGB(100,255,160)
            )
        end
    end

    count.Text = "PET RESULTS: "..found

    if found == 0 then
        local empty = label(
            scroll,
            "No pets found. Try another search!",
            UDim2.new(1,-10,0,55),
            UDim2.new(0,5,0,5),
            Color3.fromRGB(200,200,210)
        )
    end
end

search:GetPropertyChangedSignal("Text"):Connect(update)

update()
